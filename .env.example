# Salin file ini menjadi .env lalu isi yang kamu punya.
# Tanpa isian apa pun, 15 sumber gratis tetap jalan.

# --- Web umum (paling berpengaruh pada cakupan) ---
# SearXNG lokal: jalankan ./setup-searxng.sh, URL terisi otomatis.
SEARXNG_URL=
# Tavily: https://tavily.com  (daftar, lalu salin API key dari dashboard)
TAVILY_API_KEY=
# Brave Search: https://brave.com/search/api/  (cek paket dan kuota terbaru di dashboard)
BRAVE_API_KEY=
# Google Programmable Search: key dari https://console.cloud.google.com/apis/credentials
# (aktifkan "Custom Search API"), cx dari https://programmablesearchengine.google.com/
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- Opsional ---
# Menaikkan batas pencarian GitHub
GITHUB_TOKEN=
# 1 = nama/frasa dicari persis dalam tanda kutip di mesin pencari web & berita. 0 = longgar.
EXACT_MATCH=1
# Hasil per sumber yang ditampilkan di layar (daftar lengkap tetap ada di file)
MAX_PER_SOURCE=5
# Bahasa hasil SearXNG: all, id, en, ...
SEARXNG_LANG=all
